 extern "C" uint64_t work2_diag_now(){uint64_t n=0;if(OCALL_diag_now(&n)!=SGX_SUCCESS||!n)abort();return n;}
 sgx_status_t ECALL_svm_diagnostics(uint64_t* out){return work2_svm_diag_read(out)?SGX_SUCCESS:SGX_ERROR_UNEXPECTED;}
+
+extern "C" int work2_math_select(int);
+extern "C" int work2_math_bytes(unsigned char*);
+sgx_status_t ECALL_math_select(int mode){return work2_math_select(mode)?SGX_SUCCESS:SGX_ERROR_INVALID_PARAMETER;}
+sgx_status_t ECALL_math_read(uint8_t* values,int* mode){if(!values||!mode)return SGX_ERROR_INVALID_PARAMETER;*mode=work2_math_bytes(values);return (*mode==0||*mode==1)?SGX_SUCCESS:SGX_ERROR_UNEXPECTED;}
