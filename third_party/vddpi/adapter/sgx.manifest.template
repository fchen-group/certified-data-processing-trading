# Research adaptation. Benchmark fixtures are public, not production secrets.
libos.entrypoint = "/app/mypython-{{ flavor }}"
loader.log_level = "error"
loader.argv = ["/app/mypython-{{ flavor }}", "./code/{{ script }}"]
loader.env.LD_LIBRARY_PATH = "/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
loader.env.PYTHONHOME = "/opt/vddpi-python"
loader.env.PYTHONDONTWRITEBYTECODE = "1"
loader.env.PYTHONPATH = "/app/code"
fs.start_dir = "/app"
fs.mounts = [
  {path = "/lib", uri = "file:{{ gramine.runtimedir() }}"},
  {path = "/lib/x86_64-linux-gnu", uri = "file:/lib/x86_64-linux-gnu"},
  {path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu"},
  {path = "/opt/vddpi-python/lib", uri = "file:/opt/vddpi-python/lib"},
  {path = "/app", uri = "file:."},
  {path = "/app/data", uri = "file:./sgx-data", type = "encrypted", key_name = "_sgx_mrenclave"},
  {path = "/app/certs", uri = "file:./sgx-certs", type = "encrypted", key_name = "_sgx_mrenclave"},
  {path = "/logs", uri = "file:./logs"},
  {path = "/input", uri = "file:./input"},
  {path = "/tmp", type = "tmpfs"},
]
sgx.debug = false
sgx.enclave_size = "2G"
sgx.max_threads = 4
sgx.remote_attestation = "dcap"
sys.stack.size = "2M"
sgx.trusted_files = [
  "file:{{ gramine.libos }}",
  "file:{{ gramine.runtimedir() }}/",
  "file:/lib/x86_64-linux-gnu/",
  "file:/usr/lib/x86_64-linux-gnu/",
  "file:/opt/vddpi-python/lib/",
  "file:./mypython-{{ flavor }}",
  "file:./code/",
  "file:./gen_cert.py",
  "file:./fixtures/",
]
# Research-only orchestration and public input; executable code is never allowed.
sgx.allowed_files = ["file:./config.json", "file:./tokens.txt", "file:./input/", "file:./logs/"]
